generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  SUPPORT
}

enum AccountType {
  AVAILABLE
  LOCKED
  ACCRUED_RETURN
  AFFILIATE
  PENDING
  SYSTEM
}

enum LedgerEntryType {
  DEPOSIT
  INVESTMENT_CREATED
  INVESTMENT_UNLOCKED
  PERFORMANCE
  FEE
  WITHDRAWAL_REQUEST
  WITHDRAWAL_SETTLED
  WITHDRAWAL_REVERSED
  AFFILIATE_COMMISSION
  REFUND
  ADJUSTMENT
  TRANSFER
}

enum InvestmentStatus {
  CREATED
  ACTIVE
  LOCKED
  SETTLEMENT_PENDING
  SETTLED
  COMPLETED
}

enum WithdrawalStatus {
  REQUESTED
  VALIDATING
  APPROVED
  PROCESSING
  BROADCAST
  CONFIRMING
  COMPLETED
  REJECTED
  CANCELLED
  FAILED
}

enum DepositStatus {
  CREATED
  PENDING
  CONFIRMING
  CONFIRMED
  EXPIRED
  FAILED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_USER
  RESOLVED
  CLOSED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts     Account[]
  investments  Investment[]
  deposits     Deposit[]
  withdrawals  Withdrawal[]
  ledgerEntries LedgerEntry[]
  auditLogs    AuditLog[]
  tickets      SupportTicket[]
  affiliate    AffiliateProfile?
}

model Account {
  id       String      @id @default(cuid())
  userId   String
  type     AccountType
  currency String      @default("USD")
  balance  Decimal     @default(0) @db.Decimal(30, 8)
  version  Int         @default(0)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerEntries LedgerEntry[]

  @@unique([userId, type, currency])
}

model Investment {
  id                  String           @id @default(cuid())
  userId              String
  name                String
  principal           Decimal          @db.Decimal(30, 8)
  feeRate             Decimal          @db.Decimal(12, 8)
  realizedPerformance Decimal          @default(0) @db.Decimal(30, 8)
  status              InvestmentStatus @default(CREATED)
  startAt             DateTime?
  unlockAt            DateTime?
  settledAt           DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerEntries LedgerEntry[]
}

model Deposit {
  id             String        @id @default(cuid())
  userId         String
  amount         Decimal       @db.Decimal(30, 8)
  currency       String        @default("USD")
  provider       String?
  providerRef    String?
  status         DepositStatus @default(CREATED)
  idempotencyKey String        @unique
  createdAt      DateTime      @default(now())
  confirmedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([providerRef])
}

model Withdrawal {
  id             String           @id @default(cuid())
  userId         String
  amount         Decimal          @db.Decimal(30, 8)
  currency       String           @default("USD")
  address        String
  network        String
  status         WithdrawalStatus @default(REQUESTED)
  idempotencyKey String           @unique
  providerRef    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LedgerEntry {
  id          String          @id @default(cuid())
  transactionId String
  userId      String
  accountId   String
  type        LedgerEntryType
  amount      Decimal         @db.Decimal(30, 8)
  currency    String          @default("USD")
  direction   String
  referenceId String?
  description String?
  createdAt   DateTime        @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([userId, createdAt])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String    @unique
  payload     Json
  status      String    @default("RECEIVED")
  createdAt   DateTime  @default(now())
  processedAt DateTime?
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
}

model SupportTicket {
  id        String       @id @default(cuid())
  userId    String
  subject   String
  category  String
  message   String
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AffiliateProfile {
  id              String  @id @default(cuid())
  userId          String  @unique
  tier            String  @default("AI Partner")
  commissionRate  Decimal @default(0.10) @db.Decimal(5, 4)
  referralCode    String  @unique
  clicks          Int     @default(0)
  conversions     Int     @default(0)
  totalCommission Decimal @default(0) @db.Decimal(30, 8)
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
